<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Version>10.1.3</Version>
    <FileVersion>10.1.3</FileVersion>
    <AssemblyVersion>10.1.3</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Services\Diamond.Core.Example.AutoMapperDependency.Profiles.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Services\Diamond.Core.Example.AutoMapperDependency.Profiles.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="16.2.0" />
  </ItemGroup>

</Project>
